# CML: the cloud CML's MCP server. Header values are HTTP Basic auth (base64 of user:password).
# Never commit real values.
CML_MCP_URL=
CML_AUTH_HEADER=
PYATS_AUTH_HEADER=
PYATS_ENABLE_HEADER=

# Amazon Bedrock, using an AWS profile from ~/.aws (no AWS keys here).
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=

# Splunk Agent Observability (Galileo console). Each agent sets its own agent stream in code.
SPLUNK_AO_CONSOLE_URL=
SPLUNK_AO_API_KEY=
SPLUNK_AO_PROJECT=

# Send each span to Splunk on its own; large batches lose their Input/Output
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=

# Agent Control: checks tool calls against the Controls on the agent stream
AGENT_CONTROL_URL=

# Optional: with /memory on, summarize once earlier turns pass this many tokens
# MEMORY_TOKEN_LIMIT=2000
